<?xml version="1.0" encoding="utf-8"?>
<!--
  Rutas que el FileProvider (ver AndroidManifest.xml) autoriza a exponer a
  otras apps vía content:// URIs, usado solo como respaldo si ningún
  gestor de archivos del dispositivo soporta el URI de carpeta que se
  intenta primero (ver `_abrirCarpetaEnAndroid` en
  `lib/core/plataforma/abrir_carpeta.dart`). `external-files-path`
  corresponde a `context.getExternalFilesDir(null)`, que es exactamente lo
  que devuelve `path_provider`'s `getExternalStorageDirectory()`, la
  carpeta donde `directorioExportacion()` guarda los DXF/PDF/JSON
  exportados en Android.
-->
<paths>
    <external-files-path name="documentos" path="."/>
</paths>
